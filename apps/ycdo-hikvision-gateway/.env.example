PORT=9000
NODE_ENV=production

# Existing HRMS API
HRMS_API=https://hrms-api.ycdo.org.pk
HRMS_RAW_SCAN_PATH=/attendance/raw-scan
DEVICE_API_KEY=CHANGE_ME

# Receiver behavior — MUST be on CapRover persistent volume /app/data
DB_PATH=/app/data/events.db
DATA_DIR=/app/data
DEVICES_CONFIG=/app/config/devices.json
OUTBOX_POLL_MS=3000
RETRY_BASE_MS=5000
RETRY_MAX_MS=300000
REQUEST_TIMEOUT_MS=12000

# CapRover/Nginx: set to 1 only when this app is reachable only through your trusted reverse proxy.
TRUST_PROXY=1

# Optional diagnostics — required for web admin UI at /admin/
SAVE_IMAGES=false
CAPTURE_DIR=/app/data/captures
ADMIN_TOKEN=CHANGE_TO_A_LONG_RANDOM_ADMIN_TOKEN

# CapRover: optional — only seeds DB on first run when empty. Prefer /admin/ UI instead.
# DEVICES_JSON={"devices":[{"name":"YCDO Central Hospital","token":"64-char-hex","hrmsDeviceId":"YCDO-CENTRAL-HOSPITAL","hikvisionDeviceIds":[],"allowedPublicIps":[],"enabled":true}]}
# Do NOT put a plain secret or placeholder here — it must be valid JSON or be omitted entirely.

# Keep false until /attendance/raw-scan DTO accepts these fields.
SEND_AUTH_METHOD=false
