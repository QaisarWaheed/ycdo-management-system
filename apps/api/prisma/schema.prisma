generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── CORE STRUCTURE ───────────────────────────────────────

model Project {
  id        String      @id @default(uuid())
  name      String
  type      ProjectType
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())

  branches           Branch[]
  projectDepartments ProjectDepartment[]
  managerScopes      UserManagerScope[]
}

enum ProjectType {
  HOSPITAL
  VTI
  KITCHEN
  SOFTWARE_HOUSE
}

model Branch {
  id           String   @id @default(uuid())
  name         String
  abbreviation String?
  address      String?
  phone        String?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(999)
  createdAt    DateTime @default(now())
  projectId    String?

  project                Project?            @relation(fields: [projectId], references: [id])
  departments            Department[]
  employees              Employee[]
  employmentHistory      EmploymentHistory[]
  suspensionFromRequests SuspensionRequest[]
  inquiryDestinations    Inquiry[]           @relation("InquiryDestinationBranch")
  attendanceLogs         AttendanceLog[]
  shifts                 Shift[]
  relieverSessions       RelieverSession[]
  location               BranchLocation?
  biometricDevices       BiometricDevice[]
  adminUsers             User[]
  faceSyncResults        FaceSyncResult[]
  mutualSwaps            MutualSwap[]
}

model BiometricDevice {
  id        String   @id @default(uuid())
  deviceId  String   @unique
  branchId  String
  label     String?
  createdAt DateTime @default(now())

  branch Branch @relation(fields: [branchId], references: [id])
}

model BiometricDeviceEvent {
  id         String   @id @default(uuid())
  deviceId   String
  serialNo   String
  employeeId String?
  accepted   Boolean
  reason     String?
  createdAt  DateTime @default(now())

  @@unique([deviceId, serialNo])
}

model FaceSyncJob {
  id         String   @id @default(uuid())
  employeeId String
  photoUrl   String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee Employee         @relation(fields: [employeeId], references: [id])
  results  FaceSyncResult[]
}

model FaceSyncResult {
  id       String   @id @default(uuid())
  jobId    String
  deviceId String
  branchId String
  status   String
  error    String?
  syncedAt DateTime @default(now())

  job    FaceSyncJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  branch Branch      @relation(fields: [branchId], references: [id])

  @@unique([jobId, deviceId])
}

model Shift {
  id        String   @id @default(uuid())
  branchId  String?
  name      String
  startTime String
  endTime   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  branch      Branch?      @relation(fields: [branchId], references: [id])
  employees   Employee[]
  mutualSwaps MutualSwap[]

  @@unique([name, startTime, endTime])
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  isActive  Boolean  @default(true)
  isDeleted Boolean  @default(false)
  sortOrder Int      @default(999)
  createdAt DateTime @default(now())

  employees          Employee[]
  employmentHistory  EmploymentHistory[]
  projectDepartments ProjectDepartment[]
  managerScopes      UserManagerScope[]
  appointmentTemplateMappings AppointmentTemplateMapping[]
}

/// Links a HOSPITAL project to departments that may be assigned as manager scopes.
model ProjectDepartment {
  id           String   @id @default(uuid())
  projectId    String
  departmentId String
  createdAt    DateTime @default(now())

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([projectId, departmentId])
  @@index([projectId])
  @@index([departmentId])
}

// ─── EMPLOYEE ─────────────────────────────────────────────

model Employee {
  id                  String         @id @default(uuid())
  employeeCode        String         @unique
  fullName            String
  fatherName          String?
  cnic                String?        @unique
  phone               String?
  email               String?        @unique
  dateOfBirth         DateTime?
  gender              Gender
  address             String?
  joiningDate         DateTime
  status              EmployeeStatus @default(ACTIVE)
  /// First calendar day the current status applies for attendance/payroll
  /// (exit/rest/dismiss: first non-working day; Active return: first paid day).
  /// Null = immediate / no pending transition.
  statusEffectiveFrom DateTime?
  currentBranchId     String
  currentDepartmentId String?
  currentDesignation  String?
  biometricId         String?        @unique
  shiftId             String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  currentBranch     Branch      @relation(fields: [currentBranchId], references: [id])
  currentDepartment Department? @relation(fields: [currentDepartmentId], references: [id])
  shift             Shift?      @relation(fields: [shiftId], references: [id])

  employmentHistory          EmploymentHistory[]
  documents                  EmployeeDocument[]
  stipendRecords             StipendRecord[]
  attendanceLogs             AttendanceLog[]
  disciplinaryActions        DisciplinaryAction[]
  suspensionRequests         SuspensionRequest[]
  disciplineEvents           DisciplineEvent[]
  letters                    Letter[]
  whatsappLetterSends        WhatsAppLetterSend[]
  leaveRecords               LeaveRecord[]
  notifications              Notification[]
  relieverSessions           RelieverSession[]
  letterReplies              LetterReply[]
  user                       User?
  academicQualifications     AcademicQualification[]
  previousEmployments        PreviousEmployment[]
  branchChangeRequests       BranchChangeRequest[]
  allegationAcknowledgements AllegationAcknowledgement[]
  relieverRequestsMade       RelieverRequest[]           @relation("RelieverRequester")
  relieverRequestsReceived   RelieverRequest[]           @relation("RelieverEmployee")
  stipendReceipts            StipendReceipt[]
  incentives                 Incentive[]
  additionalWorkingDays      AdditionalWorkingDay[]
  portalAttendances          PortalAttendance[]
  advanceLoanRequests        AdvanceLoanRequest[]
  faceSyncJobs               FaceSyncJob[]
  onboardingApproval         EmployeeOnboardingApproval?
  coveringSwaps              MutualSwap[]                @relation("CoveringSwaps")
  coveredSwaps               MutualSwap[]                @relation("CoveredSwaps")

  // Additional personal info
  fatherStatus           String?
  guardianContact        String?
  fatherContactNumber    String?
  emergencyContactName   String?
  emergencyContactNumber String?
  emergencyRelation      String?
  spouseName             String?
  spouseContactNumber    String?
  photoUrl               String?
  privatePhotoUrl        String?
  hideProfilePhoto       Boolean        @default(false)
  caste                  String?
  domicile               String?
  currentAddress         String?
  permanentAddress       String?
  district               String?
  tehsil                 String?
  policeStation          String?
  bloodGroup             String?
  staffType              StaffType      @default(NEW)
  /// Reliever-only staff: no regular duty; skipped by auto-absent marking.
  relieverOnly           Boolean        @default(false)
  dutyStartTime          String?
  dutyEndTime            String?
  /// Daily duty length in hours; half-hour steps (e.g. 6.5).
  dutyTotalHours         Float?
  /// Paid weekly rest: JS weekday 0=Sun … 6=Sat (Pakistan calendar). Empty = seven-day week.
  weeklyOffWeekdays      Int[]          @default([])
  /// Monthly paid leave allowance. Null/omitted uses the runtime default of 2 days (not unlimited).
  monthlyAllowedLeaves   Int?
  /// Pakistan calendar date: LATE/UA on this day or later count toward the next Near/Due cycle after a closed suspension inquiry reinstatement. Null = full current month.
  suspensionWatchBaselineOn DateTime?
  province               String?
  city                   String?
  permanentProvince      String?
  permanentCity          String?
  maritalStatus          MaritalStatus?
}

enum MaritalStatus {
  MARRIED
  UNMARRIED
  DIVORCED
  WIDOW
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StaffType {
  NEW
  EXISTING
  INTERNEE
}

enum EmployeeStatus {
  TRAINEE
  ACTIVE
  APPOINTED
  SUSPENDED
  TERMINATED
  RESIGNED
  DISMISSED
  ON_LEAVE
  ON_REST
  PENDING_APPROVAL
}

enum EmployeeApproverTarget {
  PRESIDENT
  FOUNDER
  CHAIRMAN_ADMIN
}

enum EmployeeOnboardingStatus {
  PENDING
  APPROVED
  REJECTED
}

model EmployeeOnboardingApproval {
  id                   String                   @id @default(uuid())
  employeeId           String                   @unique
  submittedById        String
  approverTarget       EmployeeApproverTarget
  status               EmployeeOnboardingStatus @default(PENDING)
  formSnapshot         Json
  physicalFormUrl      String?
  physicalFormMimeType String?
  physicalFormFileName String?
  reviewNote           String?
  reviewedById         String?
  reviewedAt           DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  submittedBy User     @relation("SubmittedOnboardingApprovals", fields: [submittedById], references: [id])
  reviewedBy  User?    @relation("ReviewedOnboardingApprovals", fields: [reviewedById], references: [id])
}

model RelieverSession {
  id           String    @id @default(uuid())
  employeeId   String
  branchId     String
  date         DateTime  @db.Date
  checkIn      DateTime
  checkOut     DateTime?
  totalMinutes Int       @default(0)
  createdAt    DateTime  @default(now())

  employee              Employee               @relation(fields: [employeeId], references: [id])
  branch                Branch                 @relation(fields: [branchId], references: [id])
  additionalWorkingDay  AdditionalWorkingDay?
}

// ─── DESIGNATIONS ───────────────────────────────────────────

model Designation {
  id        String   @id @default(uuid())
  title     String   @unique
  category  String
  isActive  Boolean  @default(true)
  isDeleted Boolean  @default(false)
  sortOrder Int      @default(999)
  createdAt DateTime @default(now())

  managerScopes UserManagerScope[]
  appointmentTemplateMappings AppointmentTemplateMapping[]
}

// ─── EMPLOYMENT HISTORY ───────────────────────────────────

model EmploymentHistory {
  id            String     @id @default(uuid())
  employeeId    String
  branchId      String
  departmentId  String
  designation   String
  changeType    ChangeType
  changeReason  String?
  effectiveDate DateTime
  endDate       DateTime?
  createdAt     DateTime   @default(now())

  employee   Employee   @relation(fields: [employeeId], references: [id])
  branch     Branch     @relation(fields: [branchId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])
}

enum ChangeType {
  JOINED
  TRANSFERRED
  PROMOTED
  DEMOTED
  REINSTATED
  REJOINED
}

// ─── DOCUMENTS ────────────────────────────────────────────

model EmployeeDocument {
  id           String       @id @default(uuid())
  employeeId   String
  documentType DocumentType
  fileName     String
  fileUrl      String
  uploadedAt   DateTime     @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])
}

enum DocumentType {
  CNIC
  EDUCATIONAL_CERTIFICATE
  EXPERIENCE_LETTER
  MEDICAL_CERTIFICATE
  OTHER
}

// ─── ATTENDANCE ───────────────────────────────────────────

model AttendanceLog {
  id                    String            @id @default(uuid())
  employeeId            String
  branchId              String
  date                  DateTime          @db.Date
  type                  AttendanceLogType @default(REGULAR)
  checkIn               DateTime?
  checkOut              DateTime?
  status                AttendanceStatus
  lateMinutes           Int               @default(0)
  overtimeMinutes       Int               @default(0)
  overtimePending       Boolean           @default(false)
  overtimeApprovedBy    String?
  overtimeApprovedAt    DateTime?
  source                AttendanceSource  @default(BIOMETRIC)
  note                  String?
  createdAt             DateTime          @default(now())
  /// Set once the backend stops treating this session as open (missing
  /// checkout past grace, or a controlled backfill) — independent of
  /// checkOut, which stays NULL because the employee never actually
  /// checked out. NULL means still open/active.
  sessionClosedAt       DateTime?
  /// The employee's dutyStartTime/dutyEndTime AT THE MOMENT this record was
  /// created — a fixed historical snapshot, never touched again after
  /// creation (including on later edits to this same row). Exists so a
  /// later change to Employee.dutyStartTime/dutyEndTime cannot retroactively
  /// alter what a past attendance record appears to show. NULL only for
  /// rows created before this field existed, or if the employee had no
  /// duty time configured at creation (e.g. reliever-only).
  dutyStartTimeSnapshot String?
  dutyEndTimeSnapshot   String?

  employee Employee @relation(fields: [employeeId], references: [id])
  branch   Branch   @relation(fields: [branchId], references: [id])

  @@unique([employeeId, date, type])
}

enum AttendanceLogType {
  REGULAR
  OVERTIME
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  UNMARKED
  LATE
  HALF_DAY
  ON_LEAVE
  HOLIDAY
  UNINFORMED_ABSENT
  SWAP_COVERED
  /// HR-only, retroactive: an already-recorded attendance row (real
  /// checkIn/checkOut) reclassified as covering a single continuous late
  /// arrival OR early departure within the employee's duty-duration limit.
  /// Distinct from LeaveType.SHORT_LEAVE (a prospective, request-based leave
  /// that writes HALF_DAY) — see short-leave.util.ts.
  SHORT_LEAVE
}

enum AttendanceSource {
  BIOMETRIC
  MANUAL
}

/// Permanent, DB-backed idempotency record for one raw device event
/// (POST /attendance/raw-scan). (deviceId, serialNo) uniquely identifies a
/// single hardware event; a replayed/retried delivery of the same event is
/// detected here and skipped, independent of any agent- or server-process
/// memory. Deliberately has no foreign keys — this table only needs to
/// answer "have I already handled this exact device event", not join to
/// other data.
model ProcessedDeviceEvent {
  id          String   @id @default(uuid())
  deviceId    String
  serialNo    String
  biometricId String?
  employeeId  String?
  punchType   String?
  rawStatus   String?
  processedAt DateTime @default(now())

  @@unique([deviceId, serialNo])
  @@index([deviceId])
}

enum DisciplineCategory {
  LATE
  UNINFORMED_ABSENT
  MISSING_CHECKOUT
}

/// Atomic idempotency gate for discipline.helper.ts's monthly-cycle
/// processing (late arrivals, uninformed absences, missing checkouts).
/// One genuine incident — one employee, one category, one date — may be
/// claimed at most once, enforced by the unique constraint below rather
/// than an application-level check-then-insert (which cannot be made safe
/// under concurrency). occurrence is informational only (derived at claim
/// time, for audit/debugging) and deliberately NOT part of the unique key:
/// it can legitimately shift after a correction elsewhere in the same
/// month (e.g. an earlier date reclassified to Short Leave), while the
/// incident's own date never does. Mirrors the same proven pattern already
/// used for biometric replay protection — see ProcessedDeviceEvent above.
model DisciplineEvent {
  id           String             @id @default(uuid())
  employeeId   String
  category     DisciplineCategory
  incidentDate DateTime           @db.Date
  occurrence   Int
  createdAt    DateTime           @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, category, incidentDate])
}

// ─── STIPEND ──────────────────────────────────────────────

model StipendRecord {
  id               String    @id @default(uuid())
  employeeId       String
  basicStipend     Decimal   @db.Decimal(10, 2)
  allowances       Decimal?  @db.Decimal(10, 2)
  reward           Decimal?  @db.Decimal(10, 2)
  progressReward   Decimal?  @db.Decimal(10, 2)
  fuelAllowance    Decimal?  @db.Decimal(10, 2)
  loanDeduction    Decimal?  @db.Decimal(10, 2)
  advanceDeduction Decimal?  @db.Decimal(10, 2)
  fineDeduction    Decimal?  @db.Decimal(10, 2)
  healthDeduction  Decimal?  @db.Decimal(10, 2)
  lumpsumTotal     Decimal?  @db.Decimal(10, 2)
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  createdAt        DateTime  @default(now())

  employee       Employee       @relation(fields: [employeeId], references: [id])
  payrollEntries PayrollEntry[]
}

model PayrollEntry {
  id              String        @id @default(uuid())
  stipendRecordId String
  month           Int
  year            Int
  basicStipend    Decimal       @db.Decimal(10, 2)
  totalDeductions Decimal       @default(0) @db.Decimal(10, 2)
  totalAllowances Decimal       @default(0) @db.Decimal(10, 2)
  netStipend      Decimal       @db.Decimal(10, 2)
  status          PayrollStatus @default(PENDING)
  /**
   * True when HR force-generated for a non-ACTIVE/ON_REST employee (e.g. approved suspended).
   */
  forcedNonActive Boolean       @default(false)
  processedAt     DateTime?
  createdAt       DateTime      @default(now())

  stipendRecord  StipendRecord      @relation(fields: [stipendRecordId], references: [id])
  deductions     PayrollDeduction[]
  allowances     Allowance[]
  stipendReceipt StipendReceipt?

  @@unique([stipendRecordId, month, year])
}

model Allowance {
  id             String        @id @default(uuid())
  payrollEntryId String
  type           AllowanceType
  description    String?
  amount         Decimal       @db.Decimal(10, 2)
  hours          Decimal?      @db.Decimal(10, 2)
  createdAt      DateTime      @default(now())

  payrollEntry PayrollEntry @relation(fields: [payrollEntryId], references: [id])
}

enum AllowanceType {
  OVERTIME
  RELIEVER
  CUSTOM
  ADDITIONAL_WORKING_DAYS
}

model PayrollDeduction {
  id             String        @id @default(uuid())
  payrollEntryId String
  reason         DeductionType
  amount         Decimal       @db.Decimal(10, 2)
  description    String?

  payrollEntry PayrollEntry @relation(fields: [payrollEntryId], references: [id])
}

enum DeductionType {
  LATE_ARRIVAL
  UNINFORMED_ABSENCE
  DISCIPLINARY_FINE
  UNPAID_LEAVE
  HALF_DAY
  OTHER
  /// One-day deduction for a quota-exceeded Full Leave HR rejected. Distinct
  /// from UNPAID_LEAVE (which is matched by reason alone and recomputed/
  /// upserted as a monthly aggregate elsewhere — reusing it here would risk
  /// that aggregate logic silently overwriting or deleting this exact,
  /// incident-linked deduction).
  EXTRA_LEAVE_REJECTED
}

enum PayrollStatus {
  PENDING
  PROCESSED
  PAID
}

// ─── DISCIPLINARY ─────────────────────────────────────────

model DisciplinaryAction {
  id         String             @id @default(uuid())
  employeeId String
  type       DisciplinaryType
  reason     String
  status     DisciplinaryStatus @default(OPEN)
  issuedAt   DateTime           @default(now())
  resolvedAt DateTime?
  resolution String?
  createdAt  DateTime           @default(now())

  employee          Employee           @relation(fields: [employeeId], references: [id])
  inquiry           Inquiry?
  suspensionRequest SuspensionRequest?
}

enum DisciplinaryType {
  WARNING
  SHOW_CAUSE
  FINE
  SUSPENSION
  TERMINATION
}

enum DisciplinaryStatus {
  OPEN
  UNDER_INQUIRY
  RESOLVED
  DISMISSED
}

model Inquiry {
  id                            String                       @id @default(uuid())
  disciplinaryActionId          String                       @unique
  startedAt                     DateTime                     @default(now())
  deadlineAt                    DateTime
  outcome                       InquiryOutcome?
  notes                         String?
  closedAt                      DateTime?
  inquiryOfficerUserId          String?
  inquiryOfficerName            String?
  inquiryOfficerDesignation     String?
  inquiryOfficerPhone           String?
  finding                       InquiryFinding?
  findingRecordedById           String?
  findingRecordedAt             DateTime?
  finalAction                   InquiryFinalAction?
  finalDecisionStatus           InquiryFinalDecisionStatus?
  selectedFinalApproverUserId   String?
  finalDecisionSubmittedById    String?
  finalDecisionSubmittedAt      DateTime?
  finalDecidedById              String?
  finalDecidedAt                DateTime?
  finalDecisionNote             String?
  destinationBranchId           String?
  fineAmount                    Decimal?                     @db.Decimal(10, 2)
  appliedFineDeductionId        String?
  deadlineReminderSentAt        DateTime?
  overdueNotificationSentAt     DateTime?
  durationDays                  Int?
  closeRecommendation           String?
  officiallyOpenedAt            DateTime?
  openApprovalStatus            InquiryOpenApprovalStatus?
  selectedOpenApproverUserId    String?
  openSubmittedById             String?
  openSubmittedAt               DateTime?
  openDecidedById               String?
  openDecidedAt                 DateTime?
  openDecisionNote              String?

  disciplinaryAction      DisciplinaryAction @relation(fields: [disciplinaryActionId], references: [id])
  inquiryOfficer          User?              @relation("InquiryOfficer", fields: [inquiryOfficerUserId], references: [id])
  findingRecordedBy       User?              @relation("InquiryFindingRecordedBy", fields: [findingRecordedById], references: [id])
  selectedFinalApprover   User?              @relation("InquiryFinalApprover", fields: [selectedFinalApproverUserId], references: [id])
  finalDecisionSubmittedBy User?             @relation("InquiryFinalSubmittedBy", fields: [finalDecisionSubmittedById], references: [id])
  finalDecidedBy          User?              @relation("InquiryFinalDecidedBy", fields: [finalDecidedById], references: [id])
  destinationBranch       Branch?            @relation("InquiryDestinationBranch", fields: [destinationBranchId], references: [id])
  selectedOpenApprover    User?              @relation("InquiryOpenApprover", fields: [selectedOpenApproverUserId], references: [id])
  openSubmittedBy         User?              @relation("InquiryOpenSubmittedBy", fields: [openSubmittedById], references: [id])
  openDecidedBy           User?              @relation("InquiryOpenDecidedBy", fields: [openDecidedById], references: [id])

  @@index([inquiryOfficerUserId])
  @@index([selectedFinalApproverUserId, finalDecisionStatus])
  @@index([selectedOpenApproverUserId, openApprovalStatus])
}

enum InquiryOutcome {
  REINSTATED
  TERMINATED
  REJOINED
  DISMISSED
  REST
}

enum InquiryFinding {
  GUILTY
  NOT_GUILTY
}

enum InquiryFinalAction {
  DISMISS
  TERMINATE
  REST
  FINE_AND_REINSTATE
}

enum InquiryFinalDecisionStatus {
  PENDING_APPROVAL
  REJECTED
  APPLIED
}

enum InquiryOpenApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum SuspensionRequestStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ISSUED
  CANCELLED
  COMPLETED
}

model SuspensionRequest {
  id                     String                  @id @default(uuid())
  disciplinaryActionId   String                  @unique
  letterId               String                  @unique
  employeeId             String
  status                 SuspensionRequestStatus @default(DRAFT)
  reason                 String
  periodStart            DateTime
  periodEnd              DateTime
  inquiryOfficerUserId   String
  inquiryDeadlineAt      DateTime
  selectedApproverUserId String
  submittedById          String?
  submittedAt            DateTime?
  decidedById            String?
  decidedAt              DateTime?
  decisionNote           String?
  issuedAt               DateTime?
  suspendedFromBranchId  String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  disciplinaryAction  DisciplinaryAction @relation(fields: [disciplinaryActionId], references: [id])
  letter              Letter             @relation(fields: [letterId], references: [id])
  employee            Employee           @relation(fields: [employeeId], references: [id])
  inquiryOfficer      User               @relation("SuspensionInquiryOfficer", fields: [inquiryOfficerUserId], references: [id])
  selectedApprover    User               @relation("SuspensionSelectedApprover", fields: [selectedApproverUserId], references: [id])
  submittedBy         User?              @relation("SubmittedSuspensionRequests", fields: [submittedById], references: [id])
  decidedBy           User?              @relation("DecidedSuspensionRequests", fields: [decidedById], references: [id])
  suspendedFromBranch Branch?            @relation(fields: [suspendedFromBranchId], references: [id])

  @@index([status])
  @@index([employeeId])
  @@index([selectedApproverUserId, status])
}

// ─── LETTERS ──────────────────────────────────────────────

model LetterTemplate {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  bodyHtml        String
  bodyHtmlEn      String?
  subjectUr       String?
  subjectEn       String?
  enTitle         String?
  enPrescribed    String?
  enSubtitle      String?
  letterCode      String?
  fieldsSchema    Json?
  primaryLanguage String   @default("ur")
  isCustom        Boolean  @default(false)
  requiredVars    String[]
  version         Int      @default(1)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Letter {
  id                      String       @id @default(uuid())
  employeeId              String
  letterType              LetterType
  status                  LetterStatus @default(SENT)
  content                 Json
  generatedAt             DateTime     @default(now())
  printedAt               DateTime?
  fileUrl                 String?
  letterNo                String?      @unique
  variables               Json?
  templateVersion         Int?
  templateCode            String?
  replyDeadline           DateTime?
  isReplied               Boolean      @default(false)
  autoEscalated           Boolean      @default(false)
  requiresAcknowledgement Boolean      @default(false)
  whatsappSharedAt        DateTime?
  whatsappShareChannel    String?
  reversedAt              DateTime?
  reversedById            String?
  reversalReason          String?

  employee          Employee                   @relation(fields: [employeeId], references: [id])
  reversedBy        User?                      @relation("LetterReversedBy", fields: [reversedById], references: [id])
  replies           LetterReply[]
  acknowledgement   AllegationAcknowledgement?
  whatsappSend      WhatsAppLetterSend?
  suspensionRequest SuspensionRequest?

  @@index([status])
  @@index([employeeId, status])
}

enum AppointmentLetterLanguage {
  UR
  EN
}

/// Routes Appointment letters: Department + Designation (+ fallbacks) → template + language.
model AppointmentTemplateMapping {
  id             String                      @id @default(uuid())
  departmentId   String?
  designationId  String?
  language       AppointmentLetterLanguage
  templateCode   String
  active         Boolean                     @default(true)
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  department  Department?  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  designation Designation? @relation(fields: [designationId], references: [id], onDelete: Cascade)

  @@index([departmentId, designationId])
  @@index([templateCode])
}

model WhatsAppLetterSend {
  id            String             @id @default(uuid())
  letterId      String             @unique
  employeeId    String
  phoneE164     String
  status        WhatsAppSendStatus @default(PENDING)
  error         String?
  attempts      Int                @default(0)
  metaMessageId String?
  lastTriedAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  letter   Letter   @relation(fields: [letterId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([status])
}

enum WhatsAppSendStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model LetterReply {
  id         String   @id @default(uuid())
  letterId   String
  employeeId String
  replyText  String   @db.Text
  repliedAt  DateTime @default(now())
  createdAt  DateTime @default(now())

  letter   Letter   @relation(fields: [letterId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])
}

enum LetterType {
  APPOINTMENT
  WARNING
  ADVICE
  DISCIPLINARY
  EXPLANATION
  SHOW_CAUSE
  FINE
  INQUIRY
  APPRECIATION
  TRANSFER
  SUSPENSION
  TERMINATION
  REINSTATEMENT
  REJOINING
  SALARY_INCREMENT
  EXPERIENCE
  EXPLANATION_FINE
  /// Pre-suspension eligibility notice (Due for Suspension). Not a Suspension letter.
  SUSPENSION_ELIGIBILITY
  /// Preventive Near-Suspension warning. Not a Suspension or eligibility letter.
  NEAR_SUSPENSION_WARNING
  CUSTOM
}

enum LetterStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  REVERSED
}

// ─── LEAVE ────────────────────────────────────────────────

model LeaveRecord {
  id              String              @id @default(uuid())
  employeeId      String
  leaveType       LeaveType           @default(REGULAR)
  startDate       DateTime
  endDate         DateTime
  totalDays       Int
  status          LeaveStatus         @default(PENDING)
  reason          String?
  approvedBy      String?
  currentStage    LeaveApprovalStage? @default(BRANCH_MANAGER)
  branchManagerId String?
  deptInchargeId  String?
  createdAt       DateTime            @default(now())

  employee        Employee         @relation(fields: [employeeId], references: [id])
  relieverRequest RelieverRequest?
  approvals       LeaveApproval[]
}

model LeaveApproval {
  id        String              @id @default(uuid())
  leaveId   String
  stage     LeaveApprovalStage
  action    LeaveApprovalAction
  actionBy  String
  actionAt  DateTime            @default(now())
  notes     String?
  createdAt DateTime            @default(now())

  leave        LeaveRecord @relation(fields: [leaveId], references: [id])
  actionByUser User        @relation("LeaveApprovals", fields: [actionBy], references: [id])
}

enum LeaveApprovalStage {
  BRANCH_MANAGER
  DEPARTMENT_INCHARGE
  HR_OPERATIONS
  /// The distinct HR decision on a PENDING_APPROVAL (quota-exceeded) leave —
  /// logged via the same LeaveApproval audit trail as every other stage.
  QUOTA_EXCEPTION
}

enum LeaveApprovalAction {
  APPROVED
  REJECTED
}

enum LeaveType {
  REGULAR
  SHORT_LEAVE
  EMERGENCY
}

enum LeaveStatus {
  PENDING
  BRANCH_APPROVED
  DEPT_APPROVED
  RELIEVER_PENDING
  RELIEVER_CONFIRMED
  RELIEVER_REJECTED
  HR_PENDING
  APPROVED
  REJECTED
  CANCELLED
  /// Chain-approved (or HR-emergency-created) but exceeds the employee's
  /// normal monthly Full Leave (2) or Short Leave (3, shared across the
  /// portal and HR-emergency flows) entitlement — awaiting a distinct HR
  /// quota-exception decision (see LeaveApprovalStage.QUOTA_EXCEPTION).
  /// Approving moves to APPROVED and reconciles attendance exactly like a
  /// normal approval; rejecting moves to REJECTED with no leave protection.
  PENDING_APPROVAL
}

enum StipendStatus {
  PENDING
  ACCEPTED
  REJECTED
  AUTO_ACCEPTED
}

enum RelieverRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  AUTO_REJECTED
  HR_ASSIGNED
}

model RelieverRequest {
  id             String                @id @default(uuid())
  leaveRecordId  String                @unique
  requestedById  String
  relieverId     String
  status         RelieverRequestStatus @default(PENDING)
  requestedAt    DateTime              @default(now())
  respondedAt    DateTime?
  autoRejectedAt DateTime?
  hrAssigned     Boolean               @default(false)
  hrAssignedBy   String?
  hrAssignedAt   DateTime?
  notes          String?
  createdAt      DateTime              @default(now())

  leaveRecord LeaveRecord @relation(fields: [leaveRecordId], references: [id])
  requestedBy Employee    @relation("RelieverRequester", fields: [requestedById], references: [id])
  reliever    Employee    @relation("RelieverEmployee", fields: [relieverId], references: [id])
}

model StipendReceipt {
  id              String        @id @default(uuid())
  employeeId      String
  payrollEntryId  String        @unique
  month           Int
  year            Int
  amount          Decimal       @db.Decimal(10, 2)
  status          StipendStatus @default(PENDING)
  acceptedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  autoAcceptedAt  DateTime?
  generatedAt     DateTime      @default(now())
  deadlineAt      DateTime

  employee     Employee     @relation(fields: [employeeId], references: [id])
  payrollEntry PayrollEntry @relation(fields: [payrollEntryId], references: [id])
}

model Incentive {
  id         String   @id @default(uuid())
  employeeId String
  amount     Decimal  @db.Decimal(10, 2)
  reason     String   @db.Text
  addedBy    String
  month      Int
  year       Int
  createdAt  DateTime @default(now())

  employee    Employee @relation(fields: [employeeId], references: [id])
  addedByUser User     @relation(fields: [addedBy], references: [id])
}

/// Extra full duty-days credited by HR (e.g. covering double duty).
/// Payroll: days in month × dailyDutyHours × hourlyRate as separate slip line.
model AdditionalWorkingDay {
  id                String   @id @default(uuid())
  employeeId        String
  date              DateTime @db.Date
  note              String?
  addedById         String
  /// Set when auto-created from a completed RelieverSession (profile only; pay via RELIEVER).
  relieverSessionId String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  addedBy         User             @relation(fields: [addedById], references: [id])
  relieverSession RelieverSession? @relation(fields: [relieverSessionId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([employeeId, date])
}

// ─── AUTH & USERS ─────────────────────────────────────────

model User {
  id              String    @id @default(uuid())
  employeeId      String?   @unique
  email           String    @unique
  password        String
  role            UserRole
  branchId        String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  lastLogin       DateTime?
  /// Set only on successful Employee Portal login (not HRMS).
  lastPortalLogin DateTime?

  employee                     Employee?                    @relation(fields: [employeeId], references: [id])
  branch                       Branch?                      @relation(fields: [branchId], references: [id])
  auditLogs                    AuditLog[]
  broadcasts                   NotificationBroadcast[]
  incentivesAdded              Incentive[]
  additionalWorkingDaysAdded   AdditionalWorkingDay[]
  leaveApprovals               LeaveApproval[]              @relation("LeaveApprovals")
  passwordRecord               UserPassword?
  permissions                  UserPermission[]
  additionalRoles              UserAdditionalRole[]
  managerScopes                UserManagerScope[]
  submittedOnboardingApprovals EmployeeOnboardingApproval[] @relation("SubmittedOnboardingApprovals")
  reviewedOnboardingApprovals  EmployeeOnboardingApproval[] @relation("ReviewedOnboardingApprovals")
  mutualSwapsCreated           MutualSwap[]
  loginOtpChallenges           LoginOtpChallenge[]
  lettersReversed              Letter[]                     @relation("LetterReversedBy")
  selectedAsSuspensionApprover SuspensionRequest[]          @relation("SuspensionSelectedApprover")
  inquiryOfficerForSuspensions SuspensionRequest[]          @relation("SuspensionInquiryOfficer")
  submittedSuspensionRequests  SuspensionRequest[]          @relation("SubmittedSuspensionRequests")
  decidedSuspensionRequests    SuspensionRequest[]          @relation("DecidedSuspensionRequests")
  inquiriesAsOfficer           Inquiry[]                    @relation("InquiryOfficer")
  inquiryFindingsRecorded      Inquiry[]                    @relation("InquiryFindingRecordedBy")
  inquiryFinalApprovals        Inquiry[]                    @relation("InquiryFinalApprover")
  inquiryFinalSubmitted        Inquiry[]                    @relation("InquiryFinalSubmittedBy")
  inquiryFinalDecided          Inquiry[]                    @relation("InquiryFinalDecidedBy")
  inquiriesAsOpenApprover      Inquiry[]                    @relation("InquiryOpenApprover")
  inquiryOpenSubmitted         Inquiry[]                    @relation("InquiryOpenSubmittedBy")
  inquiryOpenDecided           Inquiry[]                    @relation("InquiryOpenDecidedBy")
}

model LoginOtpChallenge {
  id         String    @id @default(uuid())
  userId     String
  codeHash   String
  sentTo     String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserAdditionalRole {
  id        String   @id @default(uuid())
  userId    String
  role      UserRole
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
}

/// Hospital department/designation manager scopes (Admin Officer–equivalent within match).
model UserManagerScope {
  id            String   @id @default(uuid())
  userId        String
  projectId     String
  departmentId  String
  designationId String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  department  Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  designation Designation? @relation(fields: [designationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
  @@index([departmentId])
  @@index([userId, projectId, departmentId, designationId])
}

model MutualSwap {
  id   String   @id @default(uuid())
  date DateTime @db.Date

  coveringEmployeeId String
  coveringEmployee   Employee @relation("CoveringSwaps", fields: [coveringEmployeeId], references: [id])

  coveredEmployeeId String
  coveredEmployee   Employee @relation("CoveredSwaps", fields: [coveredEmployeeId], references: [id])

  coveredShiftId String
  coveredShift   Shift  @relation(fields: [coveredShiftId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  status      String   @default("ACTIVE")
  note        String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserPermission {
  id         String     @id @default(uuid())
  userId     String
  permission Permission
  granted    Boolean

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
}

model UserPassword {
  id        String   @id @default(uuid())
  userId    String   @unique
  plainText String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BranchLocation {
  id        String   @id @default(uuid())
  branchId  String   @unique
  latitude  Float
  longitude Float
  radius    Int      @default(200)
  createdAt DateTime @default(now())

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model PortalAttendance {
  id         String   @id @default(uuid())
  employeeId String
  type       String
  latitude   Float
  longitude  Float
  timestamp  DateTime @default(now())
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])
}

enum Permission {
  ATTENDANCE_MARK
  ATTENDANCE_EDIT
  LEAVE_APPROVE
  LEAVE_APPLY_OTHERS
  PAYROLL_MANAGE
  EMPLOYEES_CREATE
  EMPLOYEES_EDIT
  DISCIPLINARY_MANAGE
  LETTERS_GENERATE
  INCENTIVES_MANAGE
  RECRUITMENT_MANAGE
  REPORTS_VIEW
  BROADCASTS_SEND
  ORG_SETUP
}

enum UserRole {
  SUPER_ADMIN
  IT_ADMIN
  PRESIDENT
  FOUNDER
  CHAIRMAN
  HR_OPERATIONS_MANAGER
  HR_ADMIN_MANAGER
  HR_EXECUTIVE
  ADMIN_OFFICER
  HR_MANAGER
  ADMIN_MANAGER
  MEDICINE_MANAGER
  DEPARTMENT_HEAD
  PAYROLL_OFFICER
  EMPLOYEE
}

// ─── NOTIFICATIONS ────────────────────────────────────────

model Notification {
  id         String   @id @default(uuid())
  employeeId String
  message    String
  type       String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])
}

model NotificationBroadcast {
  id          String          @id @default(uuid())
  title       String
  message     String          @db.Text
  createdById String
  targetRole  BroadcastTarget
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())

  createdBy User @relation(fields: [createdById], references: [id])
}

enum BroadcastTarget {
  ALL
  SUPER_ADMIN
  PRESIDENT
  FOUNDER
  CHAIRMAN
  HR_OPERATIONS_MANAGER
  HR_ADMIN_MANAGER
  ADMIN_OFFICER
  HR_MANAGER
  ADMIN_MANAGER
  MEDICINE_MANAGER
  EMPLOYEE
}

// ─── AUDIT LOG ────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String
  entityId  String
  changes   Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ─── RECRUITMENT ──────────────────────────────────────────

model JobApplication {
  id                  String            @id @default(uuid())
  fullName            String
  email               String
  phone               String
  cnic                String?
  position            String
  branchId            String?
  resumeUrl           String?
  status              ApplicationStatus @default(APPLIED)
  appliedAt           DateTime          @default(now())
  interviewDate       DateTime?
  notes               String?
  interviewNotes      String?
  selectedSalary      Decimal?          @db.Decimal(10, 2)
  selectedDeptId      String?
  selectedBranchId    String?
  selectedDesignation String?
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  INTERVIEW_SCHEDULED
  SELECTED
  REJECTED
}

// ─── PHASE 3 EXTENSIONS ───────────────────────────────────

model AcademicQualification {
  id              String   @id @default(uuid())
  employeeId      String
  qualType        QualType @default(ACADEMIC)
  degree          String
  boardUniversity String
  obtainedMarks   String?
  totalMarks      String?
  marksType       String?
  cgpa            Decimal? @db.Decimal(3, 2)
  divisionGrade   String?
  status          String   @default("COMPLETED")
  startYear       Int?
  endYear         Int?
  createdAt       DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])
}

enum QualType {
  ACADEMIC
  JOB_RELEVANT
}

model PreviousEmployment {
  id                  String   @id @default(uuid())
  employeeId          String
  organizationName    String
  ownerAdminName      String?
  contactNumber       String?
  postalAddress       String?
  totalExperience     String?
  relevantExperience  String?
  jobResponsibilities String?  @db.Text
  createdAt           DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])
}

model BranchChangeRequest {
  id         String           @id @default(uuid())
  employeeId String
  district   String
  purpose    String           @db.Text
  startDate  DateTime
  endDate    DateTime
  duration   Int
  status     OutstationStatus @default(PENDING)
  approvedBy String?
  approvedAt DateTime?
  notes      String?
  createdAt  DateTime         @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])
}

enum OutstationStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model AllegationAcknowledgement {
  id             String   @id @default(uuid())
  letterId       String   @unique
  employeeId     String
  acknowledgedAt DateTime @default(now())
  ipAddress      String?
  createdAt      DateTime @default(now())

  letter   Letter   @relation(fields: [letterId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])
}

model LocationValue {
  id        String   @id @default(uuid())
  type      String
  value     String
  province  String?
  city      String?
  createdAt DateTime @default(now())

  @@unique([type, value])
}

model AdvanceLoanRequest {
  id               String    @id @default(uuid())
  employeeId       String
  type             String
  amount           Decimal   @db.Decimal(10, 2)
  reason           String    @db.Text
  status           String    @default("PENDING")
  approvedBy       String?
  approvedAt       DateTime?
  rejectedBy       String?
  rejectionReason  String?
  repaymentMonths  Int?
  monthlyDeduction Decimal?  @db.Decimal(10, 2)
  createdAt        DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])
}
