<!DOCTYPE html>
<html lang="ur" dir="rtl">
<head>
<meta charset="utf-8">
<style>{{{letterStyles}}}</style>
</head>
<body>
<div class="page">
  {{> ycdoLetterHeader}}

  <p class="salutation">السلام علیکم!</p>

  <div class="body">
    {{#if isFineAbsent}}
    <p>
      تحریر ہے کہ آپ بطور
      <span class="identity-strong">{{#if designation}}{{designation}}{{else}}اسٹاف{{/if}} {{#if branch}}{{branch}}{{else}}YCDO{{/if}}</span>
      میں تعینات ہیں۔
      آپ نے بمورخہ {{#if absentDate}}{{absentDate}}{{else}}مذکورہ تاریخ{{/if}} کو بغیر اطلاع و اجازت چھٹی کی ہے،
      جس کی وجہ سے ادارے کو انتظامی معاملات میں مشکلات کا سامنا کرنا پڑا۔
      یہ ادارہ کی SOP's کی سنگین خلاف ورزی ہے۔ جس کی بنا پر آپ کی دو یوم کی تنخواہ منہا کر لی جائے گی
      جو کہ ماہ {{#if deductionMonth}}{{deductionMonth}}{{else}}رواں{{/if}} کی تنخواہ سے منہا کی جائے۔
      آئندہ ہدایت کی جاتی ہے کہ آپ ادارہ کے SOP's پر عمل کریں بصورتِ دیگر آپ کے خلاف سخت کارروائی عمل میں لائی جائے گی۔
    </p>
    {{else if isFineLate}}
    <p>
      تحریر ہے کہ آپ بطور
      <span class="identity-strong">{{#if designation}}{{designation}}{{else}}اسٹاف{{/if}} {{#if branch}}{{branch}}{{else}}YCDO{{/if}}</span>
      میں تعینات ہیں۔
      مشاہدہ میں آیا ہے کہ آپ کی مسلسل ڈیوٹی پر لیٹ آنے کی رپورٹ آ رہی ہے، جیسا کہ درج ذیل بیان کیا گیا ہے:
    </p>
    {{else if isFineUniform}}
    <p>
      تحریر ہے کہ آپ بطور
      <span class="identity-strong">{{#if designation}}{{designation}}{{else}}اسٹاف{{/if}} {{#if branch}}{{branch}}{{else}}YCDO{{/if}}</span>
      میں تعینات ہیں۔
      ادارہ کے SOP's کے مطابق آپ ڈیوٹی کے دوران یونیفارم پہننے کے پابند ہیں، لیکن مشاہدہ میں آیا ہے کہ
      آپ نے {{#if fineDate}}{{fineDate}}{{else}}مذکورہ تاریخ{{/if}} کو ہسپتال میں ڈیوٹی کے دوران یونیفارم نہیں پہنا ہوا تھا
      جو کہ ادارہ کے SOP's کی بالکل ممانعت ہے۔ آپ کی اس غیر ذمہ داری پر آپ کو 200/- روپے کا جرمانہ عائد کیا جاتا ہے۔
      آئندہ آپ کی ڈیوٹی کے دوران یونیفارم لازمی پہنیں بصورتِ دیگر آپ کے خلاف سخت کارروائی عمل میں لائی جائے گی۔
    </p>
    {{else if isFineElectricity}}
    <p>
      تحریر ہے کہ آپ بطور
      <span class="identity-strong">{{#if designation}}{{designation}}{{else}}اسٹاف{{/if}} {{#if branch}}{{branch}}{{else}}YCDO{{/if}}</span>
      میں تعینات ہیں۔
      مشاہدہ میں آیا ہے کہ آپ کی برانچ کی بجلی کے استعمال کا جائزہ لینے پر معلوم ہوا کہ
      ماہِ {{#if deductionMonth}}{{deductionMonth}}{{else}}رواں{{/if}} کے دوران بجلی کا استعمال نمایاں طور پر زیادہ ہوا ہے۔
      اتنے زیادہ یونٹس کا بڑھ جانا غفلت اور لاپروائی ظاہر کرتا ہے، جس کی وجہ سے ادارے کو اضافی مالی نقصان برداشت کرنا پڑ رہا ہے۔
      لہٰذا آپ کو {{#if fineAmount}}{{fineAmount}}{{else}}مقررہ{{/if}} روپے کا جرمانہ عائد کیا جاتا ہے
      جو کہ {{#if deductionMonth}}{{deductionMonth}}{{else}}رواں{{/if}} کی تنخواہ سے منہا کر لیا جائے۔
      آئندہ کے لیے ہدایت کی جاتی ہے کہ بجلی کے استعمال کو مناسب طریقے سے مانیٹر کریں۔
    </p>
    {{else}}
    <p>
      تحریر ہے کہ آپ <span class="identity-strong">{{#if designation}}{{designation}}{{else}}اسٹاف{{/if}}</span> کی حیثیت سے
      <span class="identity-strong">{{#if branch}}{{branch}}{{else}}YCDO{{/if}}</span> پر فائز ہیں۔
      {{#if fineReason}}{{fineReason}}{{else}}آپ نے ادارہ کی SOP کی خلاف ورزی کی ہے۔{{/if}}
    </p>
    {{/if}}

    {{#if attendanceRows}}
    <table class="attendance-table">
      <thead>
        <tr><th>تاریخ</th><th>اِن ٹائم</th><th>آؤٹ ٹائم</th></tr>
      </thead>
      <tbody>
        {{#each attendanceRows}}
        <tr>
          <td>{{date}}</td>
          <td>{{inTime}}</td>
          <td>{{outTime}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{/if}}

    {{#if isFineLate}}
    <p>
      جبکہ ادارہ کی SOP's کے مطابق تمام سٹاف وقت پر آنے اور جانے کے پابند ہیں، لیکن آپ متعدد ایام سے لیٹ آ رہے ہیں
      جس کی بنا پر ادارے کو انتظامی معاملات میں دشواری کا سامنا کرنا پڑ رہا ہے۔
      لہٰذا آپ کی اس غفلت کی بناء پر آپ کی ایک دن کی تنخواہ منہا کی جاتی ہے
      جو کہ {{#if deductionMonth}}{{deductionMonth}}{{else}}رواں{{/if}} کی تنخواہ سے منہا کر لی جائے۔
      آئندہ کے لیے ہدایت کی جاتی ہے کہ آپ اپنے وقت کی پابندی کو ملحوظ خاطر رکھیں۔
    </p>
    {{else if isFineAbsent}}{{else if isFineUniform}}{{else if isFineElectricity}}{{else}}
    <p>
      لہٰذا ادارہ کی SOP کے مطابق آپ پر
      {{#if fineAmount}}{{fineAmount}}{{else}}مقررہ{{/if}}
      کا جرمانہ عائد کیا جاتا ہے جو
      {{#if deductionMonth}}ماہ {{deductionMonth}}{{else}}آئندہ{{/if}}
      کی تنخواہ سے منہا کر لیا جائے گا۔
      آپ کو ہدایت کی جاتی ہے کہ آئندہ ادارہ کی SOP پر سختی سے عمل کریں ورنہ سخت کارروائی عمل میں لائی جائے گی۔
    </p>
    {{/if}}
  </div>

  <p class="blessing">اللہ تعالیٰ آپ کا حامی و ناصر ہو!</p>

  {{> ycdoLetterFooter}}
</div>
</body>
</html>
