<!-- YCDO — NOTIFICATION OF TRANSFER. Computer-generated — no signature block. -->
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>
  @page { size: A4; margin: 16mm 16mm 18mm 16mm; }

  * { box-sizing: border-box; }

  body {
    font-family: "Times New Roman", "Liberation Serif", Times, Georgia, serif;
    font-size: 11pt;
    line-height: 1.45;
    color: #000;
    margin: 0;
  }

  .urdu-top-row {
    display: flex;
    justify-content: space-between;
    direction: rtl;
    font-family: "Noto Nastaliq Urdu", "Jameel Noori Nastaleeq", "Urdu Typesetting", serif;
    font-size: 12pt;
    margin-bottom: 8pt;
  }

  .letterhead { text-align: center; margin-bottom: 8pt; }
  .letterhead img { max-height: 70px; }
  .letterhead .office { font-size: 11pt; }
  .letterhead .org { font-size: 14pt; font-weight: bold; }
  .letterhead .loc { font-size: 11pt; }
  .letterhead .title {
    font-size: 13pt;
    font-weight: bold;
    margin-top: 8pt;
    text-decoration: underline;
  }

  .metarow {
    display: flex;
    justify-content: space-between;
    margin: 10pt 0 12pt;
    font-weight: 700;
  }

  p { margin: 0 0 8pt; text-align: justify; }

  table.transfer-table {
    width: 100%;
    border-collapse: collapse;
    margin: 10pt 0 14pt;
  }
  table.transfer-table th, table.transfer-table td {
    border: 1px solid #000;
    padding: 5pt 6pt;
    font-size: 10.5pt;
    text-align: center;
  }
  table.transfer-table th { font-weight: bold; }

  .cc { margin-top: 14pt; font-size: 10.5pt; }
  .cc .cc-title { font-weight: bold; margin-bottom: 4pt; }
  .cc div { margin-bottom: 2pt; }

  .computer-generated-notice {
    margin-top: 22pt;
    padding-top: 8pt;
    border-top: 1px solid #ccc;
    text-align: center;
    font-size: 9.5pt;
    font-family: 'Segoe UI', Arial, sans-serif;
    color: #333;
    line-height: 1.35;
  }
</style>
</head>
<body>

<div class="urdu-top-row">
  <span>یا اللہ</span>
  <span>یا محمد</span>
  <span>یا علی</span>
</div>

<div class="letterhead">
  {{#if letterheadLogoUrl}}<img src="{{letterheadLogoUrl}}" alt="YCDO">{{/if}}
  <div class="office">OFFICE OF THE</div>
  <div class="org">YOUTH COMMUNITY DEVELOPMENT ORGANIZATION</div>
  <div class="loc">MULTAN, PAKISTAN</div>
  <div class="title">NOTIFICATION OF TRANSFER</div>
</div>

<div class="metarow">
  <span>Dated: {{issueDate}}</span>
  <span>Notification: {{letterNo}}</span>
</div>

<p>
  In exercise of the administrative powers vested in the Founder/Head of
  YCDO, the following transfer/posting is hereby ordered with immediate
  effect and until further orders:
</p>

<table class="transfer-table">
  <thead>
    <tr>
      <th>Sr. No.</th>
      <th>Employee Name</th>
      <th>Designation</th>
      <th>From Branch</th>
      <th>To Branch</th>
      <th>Time</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td>1</td>
      <td>{{employeeName}}</td>
      <td>{{targetDesignation}}</td>
      <td>{{#if fromPosting}}{{fromPosting}}{{else}}{{branch}}{{/if}}</td>
      <td>{{toPosting}}</td>
      <td>{{#if timing}}{{timing}}{{else}}—{{/if}}</td>
    </tr>
  </tbody>
</table>

<p>
  The above-mentioned employee(s) are directed to hand over all official
  responsibilities, records, assets, and relevant documents to the concerned
  authority before assuming charge at their new place of posting.
</p>

<p>
  All concerned departments are directed to ensure compliance with this
  notification and facilitate the smooth transfer of duties and
  responsibilities.
</p>

<p>This notification shall take effect immediately.</p>

<div class="cc">
  <div class="cc-title">Copy to:</div>
  <div>1. Chairman Admin Department, YCDO.</div>
  <div>2. Chairman Finance Department, YCDO.</div>
  <div>3. Chairman Branch Transfer from, YCDO.</div>
  <div>4. Chairman Branch Transfer To, YCDO.</div>
  <div>5. Concerned Branch Administrators.</div>
  <div>6. Concerned Department Heads.</div>
  <div>7. Personal File of Employee(s) Concerned.</div>
  <div>8. Office Record.</div>
</div>

</body>
</html>
