<!DOCTYPE html>
<html lang="ur" dir="rtl">
<head>
<meta charset="utf-8">
<style>{{{letterStyles}}}</style>
</head>
<body>
<div class="page">
  {{> ycdoLetterHeader}}

  <p class="salutation">السلام علیکم!</p>

  <div class="body">
    <p>
      تحریر ہے کہ منظوریٔ اعلیٰ کے مطابق درج ذیل ٹرانسفر / پوسٹنگ / ٹائمنگ تبدیلی
      مورخہ {{effectiveDate}} سے تا امرِ ثانی نافذ العمل ہو گی:
    </p>

    <table class="attendance-table">
      <thead>
        <tr>
          <th>نمبر</th>
          <th>نام</th>
          <th>منجانب</th>
          <th>بجانب</th>
          <th>ٹائمنگ</th>
          <th>عہدہ</th>
        </tr>
      </thead>
      <tbody>
        {{#if transferRows}}
          {{#each transferRows}}
          <tr>
            <td>{{sr}}</td>
            <td>{{name}}</td>
            <td>{{from}}</td>
            <td>{{to}}</td>
            <td>{{timing}}</td>
            <td>{{designation}}</td>
          </tr>
          {{/each}}
        {{else}}
          <tr>
            <td>۰۱</td>
            <td>{{employeeName}}</td>
            <td>{{fromBranch}}</td>
            <td>{{toBranch}}</td>
            <td>{{timing}}</td>
            <td>{{designation}}</td>
          </tr>
        {{/if}}
      </tbody>
    </table>

    {{#if additionalNotes}}
    <p>{{additionalNotes}}</p>
    {{/if}}
  </div>

  <p class="blessing">اللہ تعالیٰ آپ کا حامی و ناصر ہو!</p>

  {{> ycdoLetterFooter}}
</div>
</body>
</html>
