# Cloudinary (employee photos + letter PDFs) — optional; omit to use local /uploads storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Public API base URL for legacy /uploads paths in face sync jobs
PUBLIC_API_URL=https://hrms-api.ycdo.org.pk

# Meta WhatsApp Cloud API (letter PDF delivery) — omit any to disable sends
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=employee_letter_issued
WHATSAPP_TEMPLATE_LANG=en

# Selection / appointment letter letterhead (optional)
LETTERHEAD_LOGO_URL=
ORG_ADDRESS=
ORG_PHONE=
ORG_EMAIL=
FOUNDER_SIGNATURE_URL=
