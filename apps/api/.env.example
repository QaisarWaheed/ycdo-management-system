# Cloudinary (employee photos + letter PDFs) — optional; omit to use local /uploads storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Shared secret for branch biometric agents and Hikvision gateway (x-device-key header)
BIOMETRIC_DEVICE_KEY=CHANGE_ME

# Public API base URL for legacy /uploads paths in face sync jobs
PUBLIC_API_URL=https://hrms-api.ycdo.org.pk

# Public HRMS web URL (used in WhatsApp Web approval messages)
HRMS_PUBLIC_URL=https://hrms-web.ycdo.org.pk

# Public Employee Portal URL (portal credential WhatsApp shares)
PORTAL_PUBLIC_URL=https://hrms-portal.ycdo.org.pk

# Optional WhatsApp numbers for onboarding approval redirects (Pakistan format)
# Used by wa.me when HR clicks Submit for Approval. Falls back to the matching
# role user's employee.phone if unset.
ONBOARDING_WHATSAPP_FOUNDER=
ONBOARDING_WHATSAPP_PRESIDENT=
ONBOARDING_WHATSAPP_CHAIRMAN=

# Meta WhatsApp Cloud API (letter PDF delivery) — omit any to disable sends
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=employee_letter_issued
WHATSAPP_TEMPLATE_LANG=en

# Selection / appointment letter letterhead (optional)
LETTERHEAD_LOGO_URL=
ORG_ADDRESS=
ORG_PHONE=
ORG_EMAIL=
FOUNDER_SIGNATURE_URL=

# Super Admin login OTP (sent after password succeeds)
SUPER_ADMIN_OTP_EMAIL=ycdoservehumanityofficial@gmail.com
# SMTP — required in production to deliver the OTP email (Gmail app password recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
